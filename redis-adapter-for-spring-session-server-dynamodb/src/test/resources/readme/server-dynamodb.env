# The region between the markers is quoted verbatim in README.md as the environment a
# container platform hands this server. ReadmeDynamoDbExamplesTests binds it as an
# environment rather than as properties, which is what proves the spelling: a variable
# that misses by one underscore reaches nothing and is never complained about.

# tag::server-dynamodb-env[]
SPRING_CLOUD_AWS_REGION_STATIC=ap-northeast-1
REDIS_ADAPTER_DYNAMODB_TABLE_NAME=redis-adapter
REDIS_ADAPTER_DYNAMODB_SHARDS=4
# end::server-dynamodb-env[]
