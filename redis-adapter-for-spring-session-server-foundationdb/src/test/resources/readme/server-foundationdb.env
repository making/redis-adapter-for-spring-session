# The region between the markers is quoted verbatim in README.md as the environment a
# container platform hands this server. ReadmeFoundationDbExamplesTests binds it as an
# environment rather than as properties, which is what proves the spelling: a variable
# that misses by one underscore reaches nothing and is never complained about.

# tag::server-foundationdb-env[]
REDIS_ADAPTER_FOUNDATIONDB_CLUSTER_FILE_CONTENTS=redis:adapter@fdb-0:4500,fdb-1:4500,fdb-2:4500
REDIS_ADAPTER_FOUNDATIONDB_KEY_PREFIX=/redis-adapter/
# end::server-foundationdb-env[]
