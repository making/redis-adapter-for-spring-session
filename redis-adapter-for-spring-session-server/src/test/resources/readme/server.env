# The region between the markers is quoted verbatim in README.md as the environment a
# container platform hands the server. ReadmeConfigurationExamplesTests binds it as an
# environment rather than as properties, which is what proves the spelling.

# tag::server-env[]
REDIS_ADAPTER_PORT=16379
REDIS_ADAPTER_PASSWORD=s3cret
REDIS_ADAPTER_DATABASES=16
REDIS_ADAPTER_IN_MEMORY_SWEEP_INTERVAL=5s
REDIS_ADAPTER_ETCD_ENDPOINTS=http://etcd-0:2379,http://etcd-1:2379
# end::server-env[]
