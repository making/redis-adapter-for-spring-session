<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>am.ik.redis</groupId>
		<artifactId>redis-adapter-for-spring-session</artifactId>
		<version>0.1.0</version>
	</parent>

	<artifactId>redis-adapter-for-spring-session-server</artifactId>
	<name>redis-adapter-for-spring-session-server</name>
	<description>Everything the Redis adapter server is except the backend it stores sessions in</description>

	<dependencies>
		<dependency>
			<groupId>am.ik.redis</groupId>
			<artifactId>redis-adapter-for-spring-session-core</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- The actuator is only reachable if something serves HTTP. This port carries the
		     health and metrics endpoints and nothing else; the sessions are served over RESP
		     on a port of their own. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!-- A server with no backend serves nothing, so the tests need one, and the bundled
		     in-memory store is the cheapest thing that is a real backend. It is the store
		     rather than the Spring wiring around it: the wiring lives in the server module of
		     that backend, which depends on this one. -->
		<dependency>
			<groupId>am.ik.redis</groupId>
			<artifactId>redis-adapter-for-spring-session-inmemory</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-resttestclient</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- End-to-end compatibility tests drive this server through a real Lettuce client
		     running stock Spring Session, so it is test-scoped here and never reaches the
		     server's runtime classpath. The starter rather than the libraries alone, because
		     an application adds exactly this and is then configured by properties: the
		     documented setup is only proven if the tests boot the same auto-configuration. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-session-data-redis</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>am.ik.maven</groupId>
				<artifactId>nullability-maven-plugin</artifactId>
				<extensions>true</extensions>
			</plugin>
			<plugin>
				<groupId>io.spring.javaformat</groupId>
				<artifactId>spring-javaformat-maven-plugin</artifactId>
			</plugin>
			<!-- The test sources are published as well. They hold the harness a backend is
			     driven with - the shipped configuration under a real Lettuce client, the key
			     names Spring Session writes, the benchmark - and every server module runs it
			     against its own backend, this project's and anybody else's. A backend nobody
			     here can see is then proven by the same tests as the ones that ship. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>test-jar</goal>
						</goals>
						<configuration>
							<excludes>
								<!-- This module's own test environment, not part of the harness. A
								     second application.properties on a consumer's test class path
								     would silently take the place of its own. -->
								<exclude>application.properties</exclude>
							</excludes>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
