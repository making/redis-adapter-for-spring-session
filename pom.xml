<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>am.ik.redis</groupId>
	<artifactId>redis-adapter-for-spring-session</artifactId>
	<version>0.1.2-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>redis-adapter-for-spring-session</name>
	<description>Redis Adapter for Spring Session</description>

	<modules>
		<module>redis-adapter-for-spring-session-core</module>
		<module>redis-adapter-for-spring-session-inmemory</module>
		<module>redis-adapter-for-spring-session-etcd</module>
		<module>redis-adapter-for-spring-session-dynamodb</module>
		<module>redis-adapter-for-spring-session-foundationdb</module>
		<module>redis-adapter-for-spring-session-server</module>
		<module>redis-adapter-for-spring-session-server-inmemory</module>
		<module>redis-adapter-for-spring-session-server-etcd</module>
		<module>redis-adapter-for-spring-session-server-dynamodb</module>
		<module>redis-adapter-for-spring-session-server-foundationdb</module>
	</modules>

	<properties>
		<java.version>25</java.version>
		<maven.compiler.release>${java.version}</maven.compiler.release>
		<maven.compiler.source>${java.version}</maven.compiler.source>
		<maven.compiler.target>${java.version}</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<spring-boot.version>4.1.0</spring-boot.version>
		<archunit.version>1.4.2</archunit.version>
		<!-- The AWS SDK the DynamoDB backend speaks with. Pinned here rather than left to
		     spring-cloud-aws so that the store module (which has no Spring) and the server
		     module built around it resolve the same SDK. -->
		<awssdk.version>2.49.3</awssdk.version>
		<spring-cloud-aws.version>4.1.0</spring-cloud-aws.version>
		<testcontainers-floci.version>2.12.0</testcontainers-floci.version>
		<!-- The FoundationDB client, and the version of the FoundationDB the tests run against:
		     one property, because they must be the same minor version. The jar carries only the
		     JNI shim, so a deployment installs the matching libfdb_c beside it and the tests
		     fetch it (.docs/design/architecture.md §13.5, §13.7). -->
		<foundationdb.version>7.4.6</foundationdb.version>
		<!-- The performance harness measures a backend rather than asserting anything about it,
		     so it is not part of an ordinary build: it takes minutes and its numbers are only
		     meaningful when nothing else is running. The "performance" profile is what runs it. -->
		<surefire.groups/>
		<surefire.excluded.groups>performance</surefire.excluded.groups>
		<!-- Do not fail the release when a module has no documentable types yet (modules are
		     filled in task by task). Central still receives a javadoc jar. -->
		<maven.javadoc.failOnError>false</maven.javadoc.failOnError>
	</properties>
	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<scm>
		<url>https://github.com/making/redis-adapter-for-spring-session</url>
		<connection>scm:git:git@github.com:making/redis-adapter-for-spring-session.git</connection>
		<developerConnection>scm:git:git@github.com:making/redis-adapter-for-spring-session.git
		</developerConnection>
	</scm>
	<url>https://github.com/making/redis-adapter-for-spring-session</url>

	<developers>
		<developer>
			<id>making</id>
			<name>Toshiaki Maki</name>
			<email>makingx@gmail.com</email>
			<url>https://ik.am</url>
		</developer>
	</developers>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${spring-boot.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>com.tngtech.archunit</groupId>
				<artifactId>archunit-junit5</artifactId>
				<version>${archunit.version}</version>
			</dependency>
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>bom</artifactId>
				<version>${awssdk.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<profiles>
		<!-- ./mvnw test -Pperformance
		     Runs only the performance harness. Each server module measures its own backend, so
		     the etcd numbers come from the etcd module and the in-memory baseline they are read
		     against from the in-memory one. It measures and reports; it asserts almost nothing,
		     so a failure here means the harness could not run rather than that a backend got
		     slower. -->
		<profile>
			<id>performance</id>
			<properties>
				<surefire.groups>performance</surefire.groups>
				<surefire.excluded.groups/>
			</properties>
		</profile>
		<!-- ./mvnw deploy -Pcentral-deploy
		     javadoc, sources and the GPG signature all have to be plugin executions bound to a
		     phase, not goals listed on the command line: `mvn package gpg:sign deploy` builds the
		     jar once for `package` and a second time for `deploy` (deploy implies every phase
		     before it, package included), so the signature taken between them stops matching the
		     jar Central actually receives. One phase, one build, one signature - and only under
		     this profile, so an ordinary install or test never tries to run gpg:sign without a key. -->
		<profile>
			<id>central-deploy</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
						<version>3.12.0</version>
						<executions>
							<execution>
								<id>attach-javadocs</id>
								<phase>package</phase>
								<goals>
									<goal>jar</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-source-plugin</artifactId>
						<version>3.4.0</version>
						<executions>
							<execution>
								<id>attach-sources</id>
								<phase>package</phase>
								<goals>
									<goal>jar-no-fork</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>3.2.8</version>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.15.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.5.6</version>
					<configuration>
						<groups>${surefire.groups}</groups>
						<excludedGroups>${surefire.excluded.groups}</excludedGroups>
					</configuration>
				</plugin>
				<plugin>
					<groupId>am.ik.maven</groupId>
					<artifactId>nullability-maven-plugin</artifactId>
					<version>0.4.3</version>
					<extensions>true</extensions>
					<executions>
						<execution>
							<goals>
								<goal>configure</goal>
								<goal>generate-package-info</goal>
							</goals>
						</execution>
					</executions>
					<configuration>
						<checking>tests</checking>
					</configuration>
				</plugin>
				<plugin>
					<groupId>io.spring.javaformat</groupId>
					<artifactId>spring-javaformat-maven-plugin</artifactId>
					<version>0.0.47</version>
					<executions>
						<execution>
							<phase>validate</phase>
							<inherited>true</inherited>
							<goals>
								<goal>validate</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>org.sonatype.central</groupId>
				<artifactId>central-publishing-maven-plugin</artifactId>
				<version>0.11.0</version>
				<extensions>true</extensions>
				<configuration>
					<publishingServerId>central</publishingServerId>
					<autoPublish>true</autoPublish>
					<waitUntil>published</waitUntil>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
